<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Gola Sizzlers — Preet Vihar, Delhi</title>
<link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Cinzel:wght@400;600&family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}

:root{
  --gold:#C9A063;
  --gold2:#e8c88a;
  --dark:#0a0907;
  --dark2:#111009;
  --panel:#141210;
  --panel2:#1a1714;
  --text:#d8cfc4;
  --muted:#7a7168;
  --ff-script:'Great Vibes',cursive;
  --ff-serif:'Cinzel',serif;
  --ff-body:'Cormorant Garamond',serif;
  --ff-sans:'Jost',sans-serif;
}

body{font-family:var(--ff-body);background:var(--dark);color:var(--text);overflow-x:hidden;font-size:16px;line-height:1.7}

/* ── SCROLLBAR ── */
::-webkit-scrollbar{width:4px}
::-webkit-scrollbar-track{background:var(--dark)}
::-webkit-scrollbar-thumb{background:var(--gold)}

/* ── NAVBAR ── */
#nav{
  position:fixed;top:0;left:0;right:0;z-index:200;
  display:flex;align-items:center;justify-content:space-between;
  padding:1.4rem 5vw;
  transition:all .4s;
}
#nav.scrolled{
  background:rgba(10,9,7,0.97);
  padding:0.9rem 5vw;
  border-bottom:1px solid rgba(201,160,99,0.12);
}
.nav-logo-wrap{display:flex;flex-direction:column;align-items:center;line-height:1}
.nav-logo-main{font-family:var(--ff-script);font-size:2rem;color:var(--gold);letter-spacing:.02em}
.nav-logo-sub{font-family:var(--ff-serif);font-size:.42rem;letter-spacing:.35em;text-transform:uppercase;color:var(--gold);opacity:.7;margin-top:-.2rem}
.nav-links{display:flex;gap:2.5rem;list-style:none;align-items:center}
.nav-links a{
  font-family:var(--ff-sans);font-size:.68rem;letter-spacing:.18em;text-transform:uppercase;
  color:var(--text);text-decoration:none;opacity:.75;transition:opacity .2s,color .2s
}
.nav-links a:hover{opacity:1;color:var(--gold)}
.nav-reserve{
  font-family:var(--ff-sans);font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;
  border:1px solid var(--gold);color:var(--gold) !important;opacity:1 !important;
  padding:.55rem 1.3rem;transition:background .2s,color .2s !important
}
.nav-reserve:hover{background:var(--gold);color:var(--dark) !important}
.burger{display:none;flex-direction:column;gap:5px;cursor:pointer;z-index:300}
.burger span{display:block;width:22px;height:1.5px;background:var(--gold)}
.mob-menu{
  display:none;position:fixed;inset:0;background:var(--dark);z-index:250;
  flex-direction:column;align-items:center;justify-content:center;gap:2.5rem
}
.mob-menu.open{display:flex}
.mob-menu a{font-family:var(--ff-serif);font-size:1.1rem;letter-spacing:.2em;text-transform:uppercase;color:var(--text);text-decoration:none;transition:color .2s}
.mob-menu a:hover{color:var(--gold)}

/* ── HERO ── */
#hero{
  min-height:100vh;position:relative;
  display:flex;align-items:center;justify-content:center;
  overflow:hidden;
}
.hero-img{
  position:absolute;inset:0;
  background:url('https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=1600&q=80') center/cover no-repeat;
  transform:scale(1.05);transition:transform 8s ease;
}
#hero:hover .hero-img{transform:scale(1)}
.hero-overlay{
  position:absolute;inset:0;
  background:linear-gradient(to bottom,rgba(10,9,7,.55) 0%,rgba(10,9,7,.65) 60%,rgba(10,9,7,1) 100%)
}
.hero-content{
  position:relative;z-index:2;text-align:center;
  padding:0 2rem;padding-top:80px;
  animation:fadeUp .9s ease forwards;
}
@keyframes fadeUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
.hero-eyebrow{
  font-family:var(--ff-sans);font-size:.65rem;letter-spacing:.3em;text-transform:uppercase;
  color:var(--gold);margin-bottom:1.2rem;opacity:.9
}
.hero-script{
  font-family:var(--ff-script);font-size:clamp(4rem,11vw,9rem);
  color:var(--gold);line-height:.95;margin-bottom:.5rem;
  text-shadow:0 2px 40px rgba(201,160,99,.15)
}
.hero-serif{
  font-family:var(--ff-serif);font-size:clamp(.9rem,2vw,1.3rem);
  letter-spacing:.25em;text-transform:uppercase;color:var(--text);
  opacity:.7;margin-bottom:2.5rem
}
.hero-ornament{
  display:flex;align-items:center;gap:1rem;justify-content:center;margin-bottom:2.5rem
}
.hero-ornament span{display:block;width:60px;height:1px;background:var(--gold);opacity:.5}
.hero-ornament i{color:var(--gold);font-size:.6rem;letter-spacing:.3em;font-style:normal;font-family:var(--ff-sans);text-transform:uppercase;opacity:.8}
.hero-btns{display:flex;gap:1.2rem;justify-content:center;flex-wrap:wrap}
.btn-border{
  display:inline-block;font-family:var(--ff-sans);font-size:.65rem;letter-spacing:.25em;
  text-transform:uppercase;text-decoration:none;
  border:1px solid rgba(201,160,99,.6);color:var(--text);
  padding:.85rem 2.2rem;transition:all .25s
}
.btn-border:hover{border-color:var(--gold);color:var(--gold);background:rgba(201,160,99,.05)}
.btn-gold{
  display:inline-block;font-family:var(--ff-sans);font-size:.65rem;letter-spacing:.25em;
  text-transform:uppercase;text-decoration:none;
  background:var(--gold);color:var(--dark);
  padding:.85rem 2.2rem;transition:all .25s
}
.btn-gold:hover{background:var(--gold2)}
.scroll-cue{
  position:absolute;bottom:2.5rem;left:50%;transform:translateX(-50%);
  display:flex;flex-direction:column;align-items:center;gap:.6rem;z-index:2
}
.scroll-cue span{font-family:var(--ff-sans);font-size:.58rem;letter-spacing:.3em;text-transform:uppercase;color:var(--gold);opacity:.6}
.scroll-line{width:1px;height:50px;background:linear-gradient(to bottom,var(--gold),transparent);animation:scrollAnim 1.8s ease-in-out infinite}
@keyframes scrollAnim{0%,100%{opacity:.6;transform:scaleY(1)}50%{opacity:1;transform:scaleY(1.1)}}

/* ── ORNAMENT / DIVIDERS ── */
.ornament{
  display:flex;align-items:center;gap:1.2rem;
  justify-content:center;margin:.5rem 0 1.5rem
}
.ornament::before,.ornament::after{content:'';display:block;height:1px;width:80px;background:var(--gold);opacity:.35}
.ornament-text{font-family:var(--ff-script);font-size:1.1rem;color:var(--gold);white-space:nowrap}
.diamond-divider{
  display:flex;align-items:center;gap:.8rem;justify-content:center;
  margin:1.5rem 0
}
.diamond-divider::before,.diamond-divider::after{content:'';flex:1;height:1px;max-width:120px;background:rgba(201,160,99,.3)}
.diamond{width:7px;height:7px;border:1px solid var(--gold);transform:rotate(45deg);opacity:.7}

/* ── SECTION LABELS ── */
.s-eyebrow{font-family:var(--ff-script);font-size:1.5rem;color:var(--gold);margin-bottom:.4rem}
.s-title{font-family:var(--ff-serif);font-size:clamp(1.6rem,3.5vw,2.8rem);letter-spacing:.12em;text-transform:uppercase;color:var(--text);line-height:1.2}
.s-sub{font-family:var(--ff-body);font-size:1rem;line-height:1.85;color:var(--muted);margin-top:1rem;max-width:520px}

/* ── SPLIT SECTION (Food / Wine) ── */
#split{display:grid;grid-template-columns:1fr 1fr;min-height:75vh}
.split-panel{
  position:relative;overflow:hidden;
  display:flex;align-items:flex-end;justify-content:center;
  padding:4rem 3rem;cursor:pointer
}
.split-panel-img{
  position:absolute;inset:0;background-size:cover;background-position:center;
  transition:transform .7s ease
}
.split-panel:hover .split-panel-img{transform:scale(1.06)}
.split-panel-overlay{
  position:absolute;inset:0;
  background:linear-gradient(to top,rgba(10,9,7,.85) 0%,rgba(10,9,7,.35) 60%,transparent 100%);
  transition:background .3s
}
.split-panel:hover .split-panel-overlay{background:linear-gradient(to top,rgba(10,9,7,.9) 0%,rgba(10,9,7,.5) 60%,rgba(10,9,7,.1) 100%)}
.split-panel-content{position:relative;z-index:2;text-align:center}
.split-panel-title{font-family:var(--ff-script);font-size:3rem;color:var(--gold);margin-bottom:1rem}
.split-panel-btn{
  display:inline-block;font-family:var(--ff-sans);font-size:.6rem;letter-spacing:.25em;
  text-transform:uppercase;text-decoration:none;
  border:1px solid rgba(201,160,99,.6);color:var(--text);
  padding:.6rem 1.6rem;transition:all .25s
}
.split-panel-btn:hover{border-color:var(--gold);color:var(--gold)}

/* ── ABOUT ── */
#about{
  display:grid;grid-template-columns:1fr 1fr;
  align-items:center;min-height:80vh;
}
.about-img{
  position:relative;overflow:hidden;height:100%;min-height:550px;
}
.about-img-bg{
  position:absolute;inset:0;
  background:url('https://restaurants-india.nears.me/wp-content/uploads/2026/01/2.webp') center/cover;
  transition:transform .7s ease
}
.about-img:hover .about-img-bg{transform:scale(1.04)}
.about-img-frame{
  position:absolute;inset:2rem;
  border:1px solid rgba(201,160,99,.2);pointer-events:none;
}
.about-text{padding:6rem 5vw;text-align:left}
.about-text .s-sub{max-width:100%}
.about-text p{font-size:1rem;line-height:1.9;color:var(--muted);margin-top:1.2rem}
.about-text p:first-of-type{font-family:var(--ff-body);font-style:italic;font-size:1.15rem;color:var(--text);opacity:.85}
.about-badge{
  display:flex;align-items:center;gap:2rem;
  margin-top:2.5rem;padding-top:2rem;
  border-top:1px solid rgba(201,160,99,.15)
}
.about-stat{text-align:center}
.about-stat-num{font-family:var(--ff-serif);font-size:2.2rem;color:var(--gold);letter-spacing:.05em}
.about-stat-label{font-family:var(--ff-sans);font-size:.6rem;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);margin-top:.2rem}

/* ── BEST DISHES (hero-style slider) ── */
#best-dishes{
  position:relative;height:90vh;overflow:hidden;
  display:flex;align-items:center;justify-content:center
}
.bd-slide{
  position:absolute;inset:0;opacity:0;transition:opacity 1s ease;
  background-size:cover;background-position:center
}
.bd-slide.active{opacity:1}
.bd-overlay{
  position:absolute;inset:0;
  background:linear-gradient(to bottom,rgba(10,9,7,.4),rgba(10,9,7,.6) 60%,rgba(10,9,7,.9) 100%)
}
.bd-content{position:relative;z-index:2;text-align:center;padding:0 2rem}
.bd-eyebrow{font-family:var(--ff-sans);font-size:.6rem;letter-spacing:.35em;text-transform:uppercase;color:var(--gold);opacity:.8;margin-bottom:.8rem}
.bd-title{font-family:var(--ff-serif);font-size:clamp(2rem,6vw,5rem);letter-spacing:.2em;text-transform:uppercase;color:var(--gold2);line-height:1.1;margin-bottom:1rem}
.bd-sub{font-family:var(--ff-body);font-style:italic;font-size:1.1rem;color:var(--text);opacity:.7;margin-bottom:2.5rem}
.bd-dots{display:flex;gap:.7rem;justify-content:center;margin-top:2rem}
.bd-dot{width:6px;height:6px;border-radius:50%;background:rgba(201,160,99,.3);cursor:pointer;transition:background .3s}
.bd-dot.active{background:var(--gold)}
.bd-arrows{
  position:absolute;top:50%;transform:translateY(-50%);
  width:100%;display:flex;justify-content:space-between;padding:0 2rem;z-index:2
}
.bd-arrow{
  width:44px;height:44px;border:1px solid rgba(201,160,99,.4);
  background:transparent;color:var(--gold);font-size:1rem;cursor:pointer;
  display:flex;align-items:center;justify-content:center;transition:all .2s
}
.bd-arrow:hover{background:var(--gold);color:var(--dark)}

/* ── MENU SECTION ── */
#menu{padding:7rem 5vw;background:var(--dark2)}
.menu-header{text-align:center;margin-bottom:4rem}
.menu-cats{
  display:flex;gap:0;justify-content:center;flex-wrap:wrap;
  border-bottom:1px solid rgba(201,160,99,.15);margin-bottom:3.5rem
}
.menu-cat-btn{
  font-family:var(--ff-sans);font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;
  padding:.8rem 1.8rem;background:none;border:none;border-bottom:1.5px solid transparent;
  color:var(--text);opacity:.5;cursor:pointer;margin-bottom:-1px;transition:all .2s
}
.menu-cat-btn:hover{opacity:.85}
.menu-cat-btn.active{opacity:1;color:var(--gold);border-bottom-color:var(--gold)}
.menu-grid{
  display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));
  gap:0;border:1px solid rgba(201,160,99,.08);
}
.menu-item{
  padding:2rem 2.2rem;border-bottom:1px solid rgba(201,160,99,.07);
  border-right:1px solid rgba(201,160,99,.07);
  display:flex;justify-content:space-between;align-items:flex-start;gap:1.5rem;
  transition:background .25s
}
.menu-item:hover{background:rgba(201,160,99,.03)}
.menu-item-left{flex:1}
.menu-item-name{font-family:var(--ff-serif);font-size:.95rem;letter-spacing:.05em;color:var(--text);margin-bottom:.4rem}
.menu-item-desc{font-family:var(--ff-body);font-style:italic;font-size:.88rem;color:var(--muted);line-height:1.6}
.menu-item-right{display:flex;flex-direction:column;align-items:flex-end;gap:.4rem;flex-shrink:0}
.menu-item-price{font-family:var(--ff-serif);font-size:1rem;color:var(--gold)}
.dot-veg{width:9px;height:9px;border-radius:50%;border:1.5px solid #4caf50;background:#2e7d32}
.dot-nv{width:9px;height:9px;border-radius:50%;border:1.5px solid #c0392b;background:#8b1a1a}
.menu-section-head{
  grid-column:1/-1;padding:.8rem 2.2rem;
  font-family:var(--ff-sans);font-size:.58rem;letter-spacing:.25em;text-transform:uppercase;
  color:var(--gold);opacity:.65;background:rgba(201,160,99,.04);
  border-bottom:1px solid rgba(201,160,99,.07)
}
.menu-cat-panel{display:none}
.menu-cat-panel.active{display:contents}

/* ── GALLERY ── */
#gallery{padding:7rem 5vw;background:var(--dark)}
.gallery-header{text-align:center;margin-bottom:4rem}
.gallery-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  grid-template-rows:auto;
  gap:.8rem
}
.g-item{
  overflow:hidden;position:relative;cursor:pointer;
}
.g-item img{
  width:100%;height:100%;object-fit:cover;display:block;
  transition:transform .6s ease;filter:brightness(.85)
}
.g-item:hover img{transform:scale(1.06);filter:brightness(1)}
.g-item.tall{grid-row:span 2}
.g-item.wide{grid-column:span 2}
.g-caption{
  position:absolute;bottom:0;left:0;right:0;
  background:linear-gradient(to top,rgba(10,9,7,.8),transparent);
  padding:1.5rem 1.2rem .8rem;
  font-family:var(--ff-body);font-style:italic;font-size:.85rem;color:var(--gold);
  opacity:0;transform:translateY(8px);transition:all .3s
}
.g-item:hover .g-caption{opacity:1;transform:translateY(0)}

/* ── OUR KITCHEN ── */
#kitchen{
  display:grid;grid-template-columns:1fr 1fr;
  align-items:center;min-height:70vh;
  background:var(--panel)
}
.kitchen-text{padding:6rem 5vw;text-align:right}
.kitchen-text .s-sub{margin-left:auto}
.kitchen-img{
  position:relative;overflow:hidden;height:100%;min-height:480px
}
.kitchen-img-bg{
  position:absolute;inset:0;
  background:url('data:image/jpeg;base64,') center/cover;
  transition:transform .7s ease
}
.kitchen-img:hover .kitchen-img-bg{transform:scale(1.04)}
.kitchen-img-label{
  position:absolute;left:0;right:0;top:50%;transform:translateY(-50%);
  text-align:center;z-index:2
}
.kitchen-img-label span{
  display:inline-block;
  background:rgba(10,9,7,.7);backdrop-filter:blur(4px);
  font-family:var(--ff-serif);font-size:.65rem;letter-spacing:.35em;text-transform:uppercase;
  color:var(--gold);padding:.7rem 2rem;border:1px solid rgba(201,160,99,.3)
}

/* ── BANQUET ── */
#banquet{padding:7rem 5vw;background:var(--dark);text-align:center}
.banquet-grid{
  display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;margin-top:4rem
}
.banquet-card{
  position:relative;overflow:hidden;
  border:1px solid rgba(201,160,99,.12);
  transition:border-color .3s,transform .3s
}
.banquet-card:hover{border-color:rgba(201,160,99,.35);transform:translateY(-4px)}
.banquet-card-img{
  height:260px;background-size:cover;background-position:center;
  transition:transform .6s ease;position:relative
}
.banquet-card:hover .banquet-card-img{transform:scale(1.04)}
.banquet-card-body{padding:2rem 1.8rem;background:var(--panel2)}
.banquet-card-title{font-family:var(--ff-serif);font-size:.95rem;letter-spacing:.12em;text-transform:uppercase;color:var(--text);margin-bottom:.6rem}
.banquet-card-text{font-family:var(--ff-body);font-style:italic;font-size:.9rem;color:var(--muted);line-height:1.7}
.banquet-card-price{
  display:inline-block;margin-top:1.2rem;
  font-family:var(--ff-serif);font-size:.8rem;letter-spacing:.1em;
  color:var(--gold);border-bottom:1px solid rgba(201,160,99,.3);padding-bottom:2px
}

/* ── TESTIMONIALS ── */
#testimonials{padding:7rem 5vw;background:var(--panel);text-align:center}
.reviews-wrap{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:1.5rem;margin-top:4rem
}
.review{
  padding:2.5rem 2rem;border:1px solid rgba(201,160,99,.1);
  position:relative;transition:border-color .3s
}
.review:hover{border-color:rgba(201,160,99,.3)}
.review::before{
  content:'\201C';font-family:var(--ff-script);font-size:5rem;color:var(--gold);
  opacity:.15;position:absolute;top:.5rem;left:1.2rem;line-height:1
}
.review-stars{color:var(--gold);font-size:.8rem;letter-spacing:.15em;margin-bottom:1.2rem;opacity:.9}
.review-text{font-family:var(--ff-body);font-style:italic;font-size:1.05rem;color:var(--text);opacity:.8;line-height:1.8;margin-bottom:1.5rem}
.review-author{font-family:var(--ff-sans);font-size:.62rem;letter-spacing:.18em;text-transform:uppercase;color:var(--gold)}
.review-source{font-family:var(--ff-sans);font-size:.58rem;color:var(--muted);margin-top:.3rem}

/* ── RESERVATION ── */
#reservation{
  padding:8rem 5vw;
  background:url('https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=1600&q=80') center/cover fixed no-repeat;
  position:relative;text-align:center
}
#reservation::before{
  content:'';position:absolute;inset:0;
  background:rgba(10,9,7,.88)
}
.res-inner{position:relative;z-index:1}
.res-form{
  max-width:680px;margin:3rem auto 0;
  background:rgba(26,23,20,.85);backdrop-filter:blur(8px);
  border:1px solid rgba(201,160,99,.18);padding:3rem 3.5rem
}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem;margin-bottom:1.2rem}
.form-row.single{grid-template-columns:1fr}
.f-group{display:flex;flex-direction:column;gap:.45rem}
.f-group label{font-family:var(--ff-sans);font-size:.6rem;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);opacity:.8}
.f-group input,.f-group select,.f-group textarea{
  background:rgba(201,160,99,.04);border:1px solid rgba(201,160,99,.14);
  color:var(--text);padding:.8rem 1rem;font-family:var(--ff-body);font-size:.95rem;
  outline:none;transition:border-color .2s;border-radius:0
}
.f-group input::placeholder,.f-group textarea::placeholder{color:rgba(216,207,196,.22)}
.f-group input:focus,.f-group select:focus,.f-group textarea:focus{border-color:var(--gold)}
.f-group select option{background:var(--panel);color:var(--text)}
.btn-submit{
  width:100%;margin-top:1.5rem;padding:1rem;
  background:var(--gold);color:var(--dark);
  font-family:var(--ff-sans);font-size:.65rem;letter-spacing:.25em;text-transform:uppercase;
  border:none;cursor:pointer;transition:background .2s
}
.btn-submit:hover{background:var(--gold2)}
.order-links{margin-top:2.5rem;display:flex;gap:1rem;justify-content:center;flex-wrap:wrap}
.order-link{
  display:inline-flex;align-items:center;gap:.7rem;
  font-family:var(--ff-sans);font-size:.65rem;letter-spacing:.15em;text-transform:uppercase;
  text-decoration:none;color:var(--text);
  border:1px solid rgba(201,160,99,.25);padding:.7rem 1.6rem;transition:all .2s
}
.order-link:hover{border-color:var(--gold);color:var(--gold)}
.order-link-brand{color:var(--gold)}

/* ── CONTACT ── */
#contact{display:grid;grid-template-columns:1fr 1fr;background:var(--dark2)}
.contact-info{padding:6rem 5vw}
.contact-item{display:flex;gap:1.2rem;align-items:flex-start;margin-bottom:2.2rem}
.contact-icon{
  width:40px;height:40px;flex-shrink:0;
  border:1px solid rgba(201,160,99,.2);
  display:flex;align-items:center;justify-content:center;
  font-size:1rem;color:var(--gold)
}
.contact-label{font-family:var(--ff-sans);font-size:.6rem;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);opacity:.7;margin-bottom:.3rem}
.contact-val{font-family:var(--ff-body);font-size:.95rem;color:var(--text);opacity:.8;line-height:1.6}
.hours-table{width:100%;margin-top:2.5rem;border-collapse:collapse}
.hours-table tr{border-bottom:1px solid rgba(201,160,99,.07)}
.hours-table td{padding:.65rem 0;font-family:var(--ff-body);font-size:.88rem}
.hours-table td:first-child{color:var(--muted)}
.hours-table td:last-child{color:var(--gold);text-align:right}
.social-row{display:flex;gap:.8rem;margin-top:2rem;flex-wrap:wrap}
.soc{
  width:36px;height:36px;border:1px solid rgba(201,160,99,.18);
  display:flex;align-items:center;justify-content:center;
  font-family:var(--ff-sans);font-size:.65rem;color:var(--muted);text-decoration:none;
  transition:all .2s
}
.soc:hover{border-color:var(--gold);color:var(--gold)}
.contact-map{
  position:relative;
  background:url('https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=900&q=80') center/cover;
  min-height:500px
}
.contact-map::before{content:'';position:absolute;inset:0;background:rgba(10,9,7,.55)}
.map-cta{
  position:absolute;inset:0;display:flex;flex-direction:column;
  align-items:center;justify-content:center;gap:1rem;z-index:1
}
.map-pin-icon{font-size:2.5rem;opacity:.8}
.map-address-text{
  font-family:var(--ff-body);font-style:italic;font-size:1rem;
  color:var(--text);text-align:center;line-height:1.7;opacity:.9;max-width:260px
}
.map-open-btn{
  margin-top:.5rem;font-family:var(--ff-sans);font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;
  color:var(--gold);text-decoration:none;border-bottom:1px solid rgba(201,160,99,.4);padding-bottom:3px;
  transition:opacity .2s
}
.map-open-btn:hover{opacity:.7}

/* ── CTA BAND ── */
#cta-band{
  padding:7rem 5vw;text-align:center;position:relative;overflow:hidden;
  background:url('https://images.unsplash.com/photo-1559339352-11d035aa65de?w=1600&q=80') center/cover
}
#cta-band::before{content:'';position:absolute;inset:0;background:rgba(10,9,7,.82)}
.cta-inner{position:relative;z-index:1}
.cta-script{font-family:var(--ff-script);font-size:clamp(3rem,9vw,7rem);color:var(--gold);line-height:.95}
.cta-sub{font-family:var(--ff-body);font-style:italic;font-size:1.1rem;color:var(--text);opacity:.7;margin:1rem 0 2.5rem}

/* ── FOOTER ── */
footer{background:var(--dark2);border-top:1px solid rgba(201,160,99,.1);padding:5rem 5vw 2rem}
.footer-grid{display:grid;grid-template-columns:1.8fr 1fr 1fr 1fr;gap:3rem;margin-bottom:4rem}
.footer-brand-name{font-family:var(--ff-script);font-size:2.2rem;color:var(--gold);margin-bottom:.6rem}
.footer-brand-sub{font-family:var(--ff-sans);font-size:.58rem;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);margin-bottom:1rem}
.footer-brand-desc{font-family:var(--ff-body);font-size:.88rem;line-height:1.75;color:var(--muted);max-width:240px}
.footer-col h4{font-family:var(--ff-sans);font-size:.58rem;letter-spacing:.25em;text-transform:uppercase;color:var(--gold);opacity:.65;margin-bottom:1.4rem}
.footer-col ul{list-style:none}
.footer-col li{margin-bottom:.65rem}
.footer-col a{font-family:var(--ff-body);font-size:.9rem;color:var(--muted);text-decoration:none;transition:color .2s}
.footer-col a:hover{color:var(--gold)}
.footer-bottom{
  border-top:1px solid rgba(201,160,99,.08);padding-top:2rem;
  display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.5rem
}
.footer-bottom p{font-family:var(--ff-sans);font-size:.6rem;letter-spacing:.1em;color:var(--muted);opacity:.6}

/* ── TOAST ── */
#toast{
  position:fixed;bottom:2.5rem;right:2.5rem;
  background:var(--gold);color:var(--dark);
  font-family:var(--ff-sans);font-size:.65rem;letter-spacing:.12em;text-transform:uppercase;
  padding:.9rem 2rem;z-index:999;
  transform:translateY(120%);opacity:0;transition:all .4s
}
#toast.show{transform:translateY(0);opacity:1}

/* ── RESPONSIVE ── */
@media(max-width:1024px){
  #about,#kitchen{grid-template-columns:1fr}
  #about .about-img,#kitchen .kitchen-img{min-height:360px}
  .kitchen-text{text-align:left}
  .kitchen-text .s-sub{margin-left:0}
  .banquet-grid{grid-template-columns:1fr 1fr}
  .footer-grid{grid-template-columns:1fr 1fr}
  #contact{grid-template-columns:1fr}
  .contact-map{min-height:340px}
}
@media(max-width:768px){
