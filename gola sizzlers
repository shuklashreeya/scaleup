<script>
// NAV SCROLL
window.addEventListener('scroll',()=>{
  document.getElementById('nav').classList.toggle('scrolled',window.scrollY>60)
})

// MOBILE NAV
function toggleMob(){
  document.getElementById('mobmenu').classList.toggle('open')
}

// SLIDER
let bdIdx=0;
const slides=document.querySelectorAll('.bd-slide');
const dots=document.querySelectorAll('.bd-dot');
function bdGo(n){
  slides[bdIdx].classList.remove('active');
  dots[bdIdx].classList.remove('active');
  bdIdx=(n+slides.length)%slides.length;
  slides[bdIdx].classList.add('active');
  dots[bdIdx].classList.add('active');
}
function bdNext(){bdGo(bdIdx+1)}
function bdPrev(){bdGo(bdIdx-1)}
setInterval(bdNext,5000);

// MENU TABS
function switchMenu(cat,btn){
  document.querySelectorAll('.menu-cat-panel').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.menu-cat-btn').forEach(b=>b.classList.remove('active'));
  document.getElementById('mp-'+cat).classList.add('active');
  btn.classList.add('active');
}

// TOAST
function showToast(){
  const t=document.getElementById('toast');
  t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'),3500);
}
</script>
